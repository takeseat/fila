# Environment Variables Template for Production
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ============================================
# Database Configuration
# ============================================
DATABASE_URL="mysql://user:password@host:3306/database"

# ============================================
# Environment Settings
# ============================================
NODE_ENV="production"
DB_ENV="production"

# ============================================
# Safety Flags (NEVER set to true in production!)
# ============================================
RUN_SEEDS="false"
ALLOW_DESTRUCTIVE_DB="false"

# ============================================
# Application Configuration
# ============================================
PORT=3000
JWT_SECRET="your-super-secret-jwt-key-change-this"
JWT_EXPIRES_IN="7d"

# ============================================
# CORS Configuration
# ============================================
CORS_ORIGIN="https://your-frontend-domain.com,https://admin.your-domain.com"

# ============================================
# WhatsApp Integration (Z-API)
# ============================================
ZAPI_BASE_URL="https://api.z-api.io"
ZAPI_INSTANCE_ID="your-instance-id"
ZAPI_INSTANCE_TOKEN="your-instance-token"
ZAPI_CLIENT_TOKEN="your-client-token"

# ============================================
# AWS Configuration (if needed)
# ============================================
# AWS_REGION="us-east-1"
# AWS_ACCESS_KEY_ID="your-access-key"
# AWS_SECRET_ACCESS_KEY="your-secret-key"

# ============================================
# Logging
# ============================================
LOG_LEVEL="info"

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
