// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Restaurant {
  id        String  @id @default(uuid())
  name      String
  tradeName String? // Optional trade/fantasy name
  cnpj      String?
  phone     String? // Optional - user phone is collected instead
  email     String? // Optional - user email is collected instead

  // Internationalized Address
  countryCode       String? @default("BR") // ISO 3166-1 alpha-2
  stateCode         String? // State/Province/Region code
  city              String
  addressLine       String? // Street address
  addressNumber     String? // Building number
  addressComplement String? // Apartment, suite, etc.
  postalCode        String? // ZIP/CEP/Postal code

  timezone  String   @default("America/Sao_Paulo")
  isActive          Boolean  @default(true) // SYSADMIN can disable restaurants
  onboardingPending Boolean  @default(true) // True until wizard is completed
  createdAt         DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Alert Settings
  waitingAlertMinutes Int?
  calledAlertMinutes  Int?

  // Average Wait Time Settings
  avgWaitWindowMinutes   Int? @default(90)
  avgWaitFallbackMinutes Int? @default(15)

  // Pickup Orders Feature
  pickupOrdersEnabled         Boolean @default(false)
  pickupOrdersWhatsappEnabled Boolean @default(true)
  pickupOrdersConfig          Json? // Message templates and settings

  users               User[]
  waitlistEntries     WaitlistEntry[]
  customers           Customer[]
  whatsappSettings    RestaurantWhatsAppSettings?
  whatsappMessageLogs WhatsAppMessageLog[]
  impersonationLogs   ImpersonationLog[]
  pickupOrders        PickupOrder[]

  plan          Plan     @default(BASIC)
  planUpdatedAt DateTime @default(now())

  @@map("restaurants")
}

enum Plan {
  BASIC
  PRO
}

model User {
  id           String   @id @default(uuid())
  restaurantId String? // Nullable for SYSADMIN users (global access)
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(MANAGER)
  isActive     Boolean  @default(false)
  emailVerifiedAt DateTime?
  verificationToken String?
  verificationTokenExpiresAt DateTime?
  language     String   @default("en")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant        Restaurant?        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  impersonationLogs ImpersonationLog[]
  pickupOrders      PickupOrder[]

  @@index([restaurantId])
  @@index([email])
  @@map("users")
}

enum UserRole {
  SYSADMIN // Platform administrator
  ADMIN // Restaurant administrator
  MANAGER // Restaurant manager
  HOSTESS // Front desk staff
}

model Customer {
  id           String    @id @default(uuid())
  restaurantId String
  name         String
  countryCode  String // ISO 3166-1 alpha-2: "BR", "US", "PT"
  ddi          String // "+55", "+1", "+351"
  phone        String // Local phone without DDI: "11999999999"
  fullPhone    String // Complete international: "+5511999999999"
  email        String?
  notes        String?   @db.Text
  lastVisitAt  DateTime? // Last time customer was seated
  totalVisits  Int       @default(0) // Total number of completed visits
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  // WhatsApp Persistence
  whatsappOptIn       Boolean   @default(false)
  whatsappOptInAt     DateTime?
  whatsappOptInSource String? // "QUEUE", "MANUAL", "IMPORT"

  restaurant      Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  waitlistEntries WaitlistEntry[]
  pickupOrders    PickupOrder[]

  @@unique([restaurantId, fullPhone])
  @@index([restaurantId])
  @@index([fullPhone])
  @@index([email])
  @@map("customers")
}

model WaitlistEntry {
  id                   String              @id @default(uuid())
  restaurantId         String              @map("restaurant_id")
  customerId           String?             @map("customer_id")
  customerName         String              @map("customer_name")
  customerPhone        String              @map("customer_phone")
  customerCountryCode  String?             @map("customer_country_code")
  partySize            Int                 @map("party_size")
  status               WaitlistEntryStatus @default(WAITING)
  estimatedWaitMinutes Int?                @map("estimated_wait_minutes")
  createdAt            DateTime            @default(now()) @map("created_at")
  calledAt             DateTime?           @map("called_at")
  seatedAt             DateTime?           @map("seated_at")
  cancelledAt          DateTime?           @map("cancelled_at")
  noShowAt             DateTime?           @map("no_show_at")

  // WhatsApp Integration
  whatsappOptIn        Boolean   @default(false) @map("whatsapp_opt_in")
  whatsappOptInAt      DateTime? @map("whatsapp_opt_in_at")
  lastNotifiedPosition Int?      @map("last_notified_position")
  lastNotifiedAt       DateTime? @map("last_notified_at")

  restaurant          Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer            Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  whatsappMessageLogs WhatsAppMessageLog[]

  @@index([restaurantId, status])
  @@index([customerId])
  // Analytics indexes for efficient reporting
  @@index([restaurantId, createdAt])
  @@index([restaurantId, status, createdAt])
  @@index([restaurantId, seatedAt])
  @@index([restaurantId, calledAt])
  @@map("waitlist_entries")
}

enum WaitlistEntryStatus {
  WAITING
  CALLED
  SEATED
  CANCELLED
  NO_SHOW
}

model RestaurantWhatsAppSettings {
  id           String  @id @default(uuid())
  restaurantId String  @unique
  isEnabled    Boolean @default(false)

  // Feature Toggles
  sendWelcome         Boolean @default(true)
  sendPositionUpdates Boolean @default(false)
  sendTurnMessage     Boolean @default(true)

  // Custom Templates (optional overrides)
  welcomeText        String? @db.Text
  positionUpdateText String? @db.Text
  yourTurnText       String? @db.Text

  // Rate Limiting Config
  minSecondsBetweenUpdates   Int @default(300) // 5 minutes default
  minPositionsChangeToNotify Int @default(5) // Notify only if position changes by at least 5

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("restaurant_whatsapp_settings")
}

model WhatsAppMessageLog {
  id                String                @id @default(uuid())
  restaurantId      String
  queueEntryId      String?
  pickupOrderId     String?
  customerPhone     String
  messageType       WhatsAppMessageType
  payload           Json?
  providerMessageId String?
  status            WhatsAppMessageStatus @default(SENT)
  errorCode         String?
  errorMessage      String?               @db.Text
  createdAt         DateTime              @default(now())

  restaurant  Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  queueEntry  WaitlistEntry? @relation(fields: [queueEntryId], references: [id], onDelete: SetNull)
  pickupOrder PickupOrder?   @relation(fields: [pickupOrderId], references: [id], onDelete: SetNull)

  @@index([restaurantId])
  @@index([queueEntryId])
  @@index([pickupOrderId])
  @@index([customerPhone])
  @@index([createdAt])
  @@map("whatsapp_message_logs")
}

enum WhatsAppMessageType {
  WELCOME
  POSITION_UPDATE
  YOUR_TURN
  ORDER_CREATED
  ORDER_READY
  ORDER_NOT_PICKED_UP
}

enum WhatsAppMessageStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

// SYSADMIN Impersonation Audit Log
model ImpersonationLog {
  id                 String    @id @default(uuid())
  sysadminUserId     String // SYSADMIN who initiated impersonation
  targetRestaurantId String // Restaurant being impersonated
  startedAt          DateTime  @default(now())
  endedAt            DateTime? // Null if session still active
  ipAddress          String?
  userAgent          String?   @db.Text
  reason             String?   @db.Text // Optional reason for impersonation
  correlationId      String? // For tracking related actions

  sysadmin         User       @relation(fields: [sysadminUserId], references: [id], onDelete: Cascade)
  targetRestaurant Restaurant @relation(fields: [targetRestaurantId], references: [id], onDelete: Cascade)

  @@index([sysadminUserId])
  @@index([targetRestaurantId])
  @@index([startedAt])
  @@map("impersonation_logs")
}

// Pickup Orders Model
model PickupOrder {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  // Order identification
  orderCode String

  // Customer info
  customerId          String?
  customer            Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName        String?
  customerPhoneE164   String
  customerCountryCode String    @default("BR")

  // Order details
  partySize Int?
  notes     String? @db.Text

  // Status tracking
  status PickupOrderStatus @default(CREATED)

  // Timestamps
  createdAt     DateTime  @default(now())
  readyAt       DateTime?
  pickedUpAt    DateTime?
  notPickedUpAt DateTime?

  // WhatsApp
  whatsappOptIn          Boolean   @default(true)
  lastWhatsAppNotifiedAt DateTime?

  // Metadata
  source          PickupOrderSource @default(MANUAL)
  createdByUserId String?
  createdByUser   User?             @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  // Relations
  whatsappMessages WhatsAppMessageLog[]

  @@index([restaurantId, status, createdAt])
  @@index([restaurantId, orderCode, createdAt])
  @@index([customerId])
  @@index([createdByUserId])
  @@map("pickup_orders")
}

enum PickupOrderStatus {
  CREATED
  READY_FOR_PICKUP
  PICKED_UP
  NOT_PICKED_UP
}

enum PickupOrderSource {
  MANUAL
  API
  POS
}

model PendingSignup {
  id        String   @id @default(uuid())
  email     String   @unique
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("pending_signups")
}
